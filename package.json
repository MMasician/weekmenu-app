{
  "name": "weekmenu-app",
  "version": "1.0.0",
  "private": true,
  "description": "PWA voor weekmenu en boodschappenlijst per huishouden; werkt lokaal en offline (zie docs/INTENT.md)",
  "scripts": {
    "build": "node tools/jsx-transform.cjs src/App.jsx src/app.js",
    "test": "node tools/run-tests.cjs",
    "test:coverage": "c8 --no-all --reporter=lcov --reporter=text --reporter=text-summary --reports-dir=coverage npm test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
